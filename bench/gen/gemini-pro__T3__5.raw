```python
import numpy as np
from scipy.stats import norm

def barrier_price(S, K, H, T, r, q, sigma, is_call, barrier_type):
    phi = 1 if is_call else -1
    
    is_down = barrier_type in ["down-and-out", "down-and-in"]
    is_in = barrier_type in ["down-and-in", "up-and-in"]
    
    eta = 1 if is_down else -1
    
    b = r - q
    sqT = sigma * np.sqrt(T)
    x1 = (np.log(S / K) + (b + 0.5 * sigma**2) * T) / sqT
    z1 = x1 - sqT
    
    A = phi * S * np.exp(-q * T) * norm.cdf(phi * x1) - phi * K * np.exp(-r * T) * norm.cdf(phi * z1)
    
    if (is_down and S <= H) or (not is_down and S >= H):
        return A if is_in else 0.0

    mu = b / sigma**2 - 0.5
    log_HS = np.log(H / S)
    
    x2 = (np.log(S / H) + (b + 0.5 * sigma**2) * T) / sqT
    z2 = x2 - sqT
    
    y1 = (np.log(H**2 / (S * K)) + (b + 0.5 * sigma**2) * T) / sqT
    y2 = (np.log(H / S) + (b + 0.5 * sigma**2) * T) / sqT
    z3 = y1 - sqT
    z4 = y2 - sqT
    
    B = phi * S * np.exp(-q * T) * norm.cdf(phi * x2) - phi * K * np.exp(-r * T) * norm.cdf(phi * z2)
    
    term_C1 = phi * S * np.exp(-q * T + (2 * mu + 2) * log_HS + norm.logcdf(eta * y1))
    term_C2 = phi * K * np.exp(-r * T + (2 * mu) * log_HS + norm.logcdf(eta * z3))
    C = term_C1 - term_C2
    
    term_D1 = phi * S * np.exp(-q * T + (2 * mu + 2) * log_HS + norm.logcdf(eta * y2))
    term_D2 = phi * K * np.exp(-r * T + (2 * mu) * log_HS + norm.logcdf(eta * z4))
    D = term_D1 - term_D2
    
    if is_call:
        if barrier_type == "down-and-in":
            return C if K >= H else A - B + D
        elif barrier_type == "down-and-out":
            return A - C if K >= H else B - D
        elif barrier_type == "up-and-in":
            return A if K >= H else B - C + D
        elif barrier_type == "up-and-out":
            return 0.0 if K >= H else A - B + C - D
    else:
        if barrier_type == "down-and-in":
            return B - C + D if K >= H else A
        elif barrier_type == "down-and-out":
            return A - B + C - D if K >= H else 0.0
        elif barrier_type == "up-and-in":
            return A - B + D if K >= H else C
        elif barrier_type == "up-and-out":
            return B - D if K >= H else A - C

    return 0.0
```