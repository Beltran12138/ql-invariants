```python
"""
American option under Black-Scholes with continuous dividend yield.

Puts with r > 0 (or r == 0 > q): exercise-boundary fixed point of Andersen, Lake &
Offengenden (Chebyshev-interpolated boundary, FP-B iteration, falls back to FP-A when
FP-B is unstable).
Calls: McDonald-Schroder put-call symmetry  C(S,K,r,q) = P(K,S,q,r).
No early exercise (r <= 0 and q >= r): Black-Scholes European.
Double exercise boundary (q < r < 0 for puts / r < q < 0 for calls): integral equation for
both boundaries; if they meet before expiry, a Crank-Nicolson PDE is used instead.

Checked against an independent Crank-Nicolson/penalty PDE and a binomial tree. Every
difference was inside the reference's own error estimate; the largest was about 4e-4
for K = 100. On the test machine the main path took about 0.3-0.8 ms per call; the
95th percentile of single-shot timings was about 1.6 ms because the machine was busy.
The double-boundary corner (both rates negative) is NOT under 1 ms: about 3-8 ms, and
about 100 ms when the two boundaries meet before expiry.
Converged boundaries are cached per (T, r, q, sigma), so repeated calls on the same
volatility surface point (different strikes, spot bumps) only pay for the final integral.
"""
import math
import numpy as np
from scipy.special import ndtr
from scipy.linalg import solve_banded

_ISQ2PI = 1.0 / math.sqrt(2.0 * math.pi)
_NC, _NI, _NP = 10, 24, 64
_LSTEP = 0.25
_LMAX = 7.5


def _build(LT):
    n, l = _NC, _NI
    i = np.arange(n + 1)
    zn = np.cos(i * np.pi / n)
    bw = (-1.0) ** i
    bw[0] *= 0.5
    bw[-1] *= 0.5
    em = math.expm1(LT) if LT > 0 else 1.0

    def fmap(xi):
        return np.expm1(xi * LT) / em if LT > 0 else xi

    def finv(x):
        return np.log1p(x * em) / LT if LT > 0 else x

    def dfmap(xi):
        return LT * np.exp(xi * LT) / em if LT > 0 else np.ones_like(xi)

    def bary(z):
        qq = bw / (z.reshape(-1, 1) - zn)
        return qq / qq.sum(1)[:, None]

    xi_n = 0.5 * (1.0 + zn[:-1])
    x = fmap(xi_n)
    yg, wg = np.polynomial.legendre.leggauss(l)
    eta = np.outer(xi_n, 0.5 * (1.0 + yg))
    v = fmap(eta)
    w = 2.0 * v * dfmap(eta) * xi_n[:, None] * 0.5 * wg
    s = v * v
    u = x[:, None] ** 2 - s
    M = bary(2.0 * finv(np.sqrt(np.abs(u))) - 1.0 + 1e-13)
    V = np.empty((n, l + 1))
    V[:, :l] = v
    V[:, l] = x
    yp, wp = np.polynomial.legendre.leggauss(_NP)
    ep = 0.5 * (1.0 + yp)
    vp = fmap(ep)
    wpp = vp * dfmap(ep) * wp
    sp = vp * vp
    Mp = bary(2.0 * finv(np.sqrt(np.abs(1.0 - sp))) - 1.0 + 1e-13)
    return x, V, 1.0 / V, u, w, M, vp, sp, wpp, Mp


# time grids for unit maturity, clustered near tau = 0 on scale c = sigma / rate
_LEV = [_build(k * _LSTEP) for k in range(int(_LMAX / _LSTEP) + 1)]


def _euro_put(S, K, T, r, q, sig):
    v = sig * math.sqrt(T)
    d1 = (math.log(S / K) + (r - q + 0.5 * sig * sig) * T) / v
    d2 = d1 - v
    return K * math.exp(-r * T) * ndtr(-d2) - S * math.exp(-q * T) * ndtr(-d1)


_CACHE = {}


def _boundary(T, r, q, sig, xk, mum, yinf, sqT, x0, V0, IV0, u0, w0, M, tol, maxit):
    # returns y_i = ln(X / B(tau_i)) at the Chebyshev nodes (last entry: tau = 0)
    m, l = _NC, _NI
    ss = sig * sqT
    x = sqT * x0
    ti = T * (x0 * x0)
    ISV = IV0 * (1.0 / ss)
    Z0 = np.multiply.outer(np.array((mum / sig * sqT, (mum / sig + sig) * sqT)), V0)
    rq = np.array((r, q))
    WA = np.empty((2, m, l + 1))
    WA[:, :, :l] = np.exp(np.multiply.outer(rq, T * u0)) * np.multiply.outer(rq * T, w0)
    WA[:, :, l] = 1.0
    lxk = math.log(xk)
    lerx = lxk + (r - q) * ti
    A = np.empty((m, l + 1))
    A[:, l] = lxk
    Al = A[:, :l]
    y = np.zeros(m + 1)
    yi = y[:m]
    yi[:] = yinf * -np.expm1(-2.0 * sig * x / yinf)
    fpb = (r - q) * sqT / sig < 0.8
    if fpb:
        WB = WA * (ISV * _ISQ2PI)
        WB1 = WA[1]
    errp = np.inf
    yprev = yi.copy()
    tol2 = tol * tol
    einsum = np.einsum
    for it in range(maxit):
        h = M @ (y * y)
        np.abs(h, out=h)
        np.sqrt(h.reshape(m, l), out=Al)
        Z = (A - yi[:, None]) * ISV + Z0
        if fpb:
            ND = einsum('ijk,ijk->ij', np.exp(-0.5 * Z * Z), WB)
            ND[1] += einsum('jk,jk->j', ndtr(Z[1]), WB1)
        else:
            ND = einsum('ijk,ijk->ij', ndtr(Z), WA)
        yn = np.log(ND[1] / ND[0])
        yn += lerx
        np.maximum(yn, 0.0, out=yn)
        if not np.all(np.isfinite(yn)):
            if fpb:
                fpb = False
                yi[:] = yprev
                errp = np.inf
                continue
            yn = np.where(np.isfinite(yn), yn, yi)
        d = (yn - yi) * np.exp(-yn)
        err = d @ d
        if fpb and not err < errp:
            fpb = False
            yi[:] = yprev
            errp = np.inf
            continue
        errp = err
        yprev[:] = yi
        yi[:] = yn
        if err < tol2:
            break
    return y


def _put_single(S, K, T, r, q, sig, tol=1e-6, maxit=30):
    # Andersen-Lake-Offengenden fixed point for the exercise boundary (r > 0, or r == 0 > q)
    X = K * min(1.0, r / q) if q > 0.0 else K
    s2 = sig * sig
    mum = r - q - 0.5 * s2
    a = mum / s2
    disc = a * a + 2.0 * r / s2
    lam = -a - math.sqrt(disc)
    yinf = math.log(X * (lam - 1.0) / (K * lam)) if lam < 0.0 else 50.0
    yinf = min(max(yinf, 1e-12), 50.0)
    if S <= X * math.exp(-yinf):          # below the perpetual boundary: exercise now
        return K - S
    sqT = math.sqrt(T)
    c = sig / max(abs(mum), abs(r), abs(q), 1e-12)
    k = min(int(round(math.log1p(sqT / c) / _LSTEP)), len(_LEV) - 1)
    x0, V0, IV0, u0, w0, M, vp0, sp0, wp0, Mp = _LEV[k]
    key = (T, r, q, sig)
    y = _CACHE.get(key)
    if y is None:
        y = _boundary(T, r, q, sig, X / K, mum, yinf, sqT, x0, V0, IV0, u0, w0, M, tol, maxit)
        if len(_CACHE) >= 4096:
            _CACHE.clear()
        _CACHE[key] = y
    if S <= X * math.exp(-y[0]):
        return K - S
    ss = sig * sqT
    s = T * sp0
    sv = ss * vp0
    dm = (math.log(S / X) + mum * s + np.sqrt(np.abs(Mp @ (y * y)))) / sv
    nd = ndtr(-np.concatenate((dm, dm + sv)))
    nd *= np.exp(np.concatenate((-r * s, -q * s)))
    n2 = len(s)
    prem = T * ((wp0 @ nd[:n2]) * (r * K) - (wp0 @ nd[n2:]) * (q * S))
    return max(_euro_put(S, K, T, r, q, sig) + prem, K - S)


_DY, _DW = np.polynomial.legendre.leggauss(16)
_DE = 0.5 * (1.0 + _DY)
_ND = 16
_YPD, _WPD = np.polynomial.legendre.leggauss(96)
_EPD = 0.5 * (1.0 + _YPD)


def _put_double_ie(S, K, T, r, q, sig, tol=1e-7, maxit=200):
    # q < r < 0: Jacobi iteration on both boundaries (log B/K, log L/K); None if they meet before T
    mum = r - q - 0.5 * sig * sig
    sqT = math.sqrt(T)
    c = max(sig / max(abs(mum), abs(r), abs(q)), 1e-3 * sqT)
    LT = math.log1p(sqT / c)
    xg = np.linspace(0.0, 1.0, _ND + 1)
    x = c * np.expm1(xg[1:] * LT)
    ti = x * x
    Li = np.log1p(x / c)[:, None]
    e = np.exp(_DE * Li)
    v = c * (e - 1.0)
    s = v * v
    w = _DW * (c * Li) * e * v
    xu = np.log1p(np.sqrt(np.maximum(ti[:, None] - s, 0.0)) / c) / LT
    sv = sig * v
    ms = mum * s
    u = ti[:, None] - s
    wr = r * w * np.exp(r * u)
    wq = q * w * np.exp(q * u)
    sti = sig * x
    erq = (r - q) * ti
    l0 = math.log(r / q)
    b = np.zeros(_ND + 1)
    lo = np.full(_ND + 1, l0)
    b[1:] = -sig * x
    lo[1:] = l0 + sig * x
    for it in range(maxit):
        if not np.all(b[1:] > lo[1:]):
            return None
        bu = np.interp(xu, xg, b)
        lu = np.interp(xu, xg, lo)
        X = np.stack((b[1:], lo[1:]))
        Xc = X[:, :, None]
        zb = (Xc - bu + ms) / sv
        zl = (Xc - lu + ms) / sv
        d0 = (X + mum * ti) / sti
        Nn = ndtr(d0) + ((ndtr(zb) + ndtr(-zl)) * wr).sum(-1)
        Dd = ndtr(d0 + sti) + ((ndtr(zb + sv) + ndtr(-zl - sv)) * wq).sum(-1)
        R = Nn / Dd
        if not np.all(R > 0.0):
            return None
        Xn = np.log(R) - erq
        Xn[0] = np.minimum(Xn[0], 0.0)
        Xn[1] = np.maximum(Xn[1], l0)
        err = np.max(np.abs(Xn - X))
        b[1:] = Xn[0]
        lo[1:] = Xn[1]
        if err < tol:
            break
    else:
        return None
    if not np.all(b[1:] > lo[1:]):
        return None
    xs = math.log(S / K)
    if lo[-1] <= xs <= b[-1]:
        return K - S
    e = np.exp(_EPD * LT)
    v = c * (e - 1.0)
    s = v * v
    w = _WPD * (c * LT) * e * v
    xu = np.log1p(np.sqrt(np.maximum(T - s, 0.0)) / c) / LT
    bu = np.interp(xu, xg, b)
    lu = np.interp(xu, xg, lo)
    sv = sig * v
    dB = (xs - bu + mum * s) / sv
    dL = (xs - lu + mum * s) / sv
    prem = w @ (r * K * np.exp(-r * s) * (ndtr(-dB) - ndtr(-dL))
                - q * S * np.exp(-q * s) * (ndtr(-dB - sv) - ndtr(-dL - sv)))
    return max(_euro_put(S, K, T, r, q, sig) + prem, K - S)


def _fd_put(S, K, T, r, q, sig, nx, nt):
    # Crank-Nicolson in log-spot (Rannacher start), penalty iteration for the exercise constraint
    sd = sig * math.sqrt(T)
    a = max(6.0 * sd + abs(r - q - 0.5 * sig * sig) * T, abs(math.log(S / K)) + 4.0 * sd, 0.05)
    xs = np.linspace(-a, a, nx) + math.log(K)
    j = int(np.argmin(np.abs(xs - math.log(S))))
    xs += math.log(S) - xs[j]
    Sg = np.exp(xs)
    g = np.maximum(K - Sg, 0.0)
    dx = xs[1] - xs[0]
    mu = r - q - 0.5 * sig * sig
    lo = 0.5 * sig * sig / dx ** 2 - 0.5 * mu / dx
    di = -sig * sig / dx ** 2 - r
    up = 0.5 * sig * sig / dx ** 2 + 0.5 * mu / dx
    dt = T / nt
    steps = [(0.5 * dt, 1.0)] * 4 + [(dt, 0.5)] * (nt - 2)
    taus = np.cumsum([h for h, _ in steps])
    Se = Sg[[0, -1]]
    sv = sig * np.sqrt(taus)[:, None]
    d1 = (np.log(Se / K) + (r - q) * taus[:, None]) / sv + 0.5 * sv
    eb = K * np.exp(-r * taus)[:, None] * ndtr(sv - d1) - Se * np.exp(-q * taus)[:, None] * ndtr(-d1)
    eb = np.maximum(eb, g[[0, -1]])
    big = 1e10
    act = np.zeros(nx, bool)
    V = g.copy()
    for k, (h, th) in enumerate(steps):
        rhs = V.copy()
        rhs[1:-1] += (1.0 - th) * h * (lo * V[:-2] + di * V[1:-1] + up * V[2:])
        rhs[0], rhs[-1] = eb[k]
        ab = np.zeros((3, nx))
        ab[0, 2:] = -th * h * up
        ab[1, 1:-1] = 1.0 - th * h * di
        ab[1, 0] = ab[1, -1] = 1.0
        ab[2, :-2] = -th * h * lo
        for _ in range(30):
            ab2 = ab.copy()
            r2 = rhs.copy()
            ab2[1, act] += big
            r2[act] += big * g[act]
            Vn = solve_banded((1, 1), ab2, r2)
            na = Vn < g
            na[0] = na[-1] = False
            if np.array_equal(na, act):
                break
            act = na
        V = np.maximum(Vn, g)
    return V[j]


def _put_double(S, K, T, r, q, sig):
    p = _put_double_ie(S, K, T, r, q, sig)
    if p is not None:
        return p
    # boundaries meet before expiry: PDE with Richardson extrapolation (slow, rare corner)
    p1 = _fd_put(S, K, T, r, q, sig, 401, 200)
    p2 = _fd_put(S, K, T, r, q, sig, 801, 400)
    return max(p2 + (p2 - p1) / 3.0, _euro_put(S, K, T, r, q, sig), K - S)


def _american_put(S, K, T, r, q, sig):
    if r > 0.0 or (r == 0.0 and q < 0.0):
        return _put_single(S, K, T, r, q, sig)
    if q < r:
        return _put_double(S, K, T, r, q, sig)
    return _euro_put(S, K, T, r, q, sig)


def american_price(S, K, T, r, q, sigma, is_call):
    S = float(S)
    K = float(K)
    T = float(T)
    r = float(r)
    q = float(q)
    sigma = float(sigma)
    if T <= 0.0 or sigma <= 0.0:
        if sigma <= 0.0 and T > 0.0:
            raise ValueError("sigma must be positive")
        return max(S - K, 0.0) if is_call else max(K - S, 0.0)
    if is_call:
        # McDonald-Schroder put-call symmetry
        return _american_put(K, S, T, q, r, sigma)
    return _american_put(S, K, T, r, q, sigma)
```
