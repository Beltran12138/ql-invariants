```python
import numpy as np

def american_price(S, K, T, r, q, sigma, is_call):
    if T <= 0.0:
        return float(max(S - K, 0.0) if is_call else max(K - S, 0.0))
    
    N = 2000
    sigma = max(sigma, 1e-10)
    dt = T / N
    v_sigma_dt = sigma * np.sqrt(dt)
    u = np.exp(v_sigma_dt)
    d = 1.0 / u
    
    p = (np.exp((r - q) * dt) - d) / (u - d)
    p = np.clip(p, 0.0, 1.0)
    
    df = np.exp(-r * dt)
    
    S_vec = S * np.exp(np.arange(-N, N + 1) * v_sigma_dt)
    S_T = S_vec[0 : 2 * N + 1 : 2]
    
    if is_call:
        V = np.maximum(S_T - K, 0.0)
    else:
        V = np.maximum(K - S_T, 0.0)
        
    for i in range(N - 1, -1, -1):
        V = df * (p * V[1:] + (1.0 - p) * V[:-1])
        S_t = S_vec[N - i : N + i + 1 : 2]
        if is_call:
            V = np.maximum(V, S_t - K)
        else:
            V = np.maximum(V, K - S_t)
            
    return float(V[0])
```